rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User subscription status (written by backend via Stripe webhook; user reads own)
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    // Anonymous readings: any signed-in user can add; no one reads raw readings in the app
    match /readings/{id} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }
    // Aggregates: updated by app when a reading is added; everyone can read (Discovery)
    match /aggregates/{reference} {
      allow read: if true;
      allow create, update: if request.auth != null;
      allow delete: if false;
    }
    // AI usage: backend only (Admin SDK); clients have no access
    match /aiUsage/{uid} {
      allow read, write: if false;
    }
  }
}
