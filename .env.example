# Firebase: add a Web app in Firebase Console (Project Settings → Your apps) and paste the config below.
# For production (e.g. Vercel), set these same variables in your host's environment.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional, for Analytics
VITE_FIREBASE_MEASUREMENT_ID=

# Optional: override API base (e.g. https://your-api.vercel.app). Leave blank when API is on same host.
# VITE_API_URL=

# Optional: App Store “write a review” URL (Settings → Review on App Store). Example:
# VITE_APP_STORE_REVIEW_URL=https://apps.apple.com/app/idYOUR_ID?action=write-review

# --- Backend (Vercel serverless / API routes) — required for Stripe subscriptions ---
# See docs/SUBSCRIPTION_CONFIG.md for step-by-step setup.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PRICE_ID=price_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Firebase Admin (verify tokens, write subscription from webhook) — same project as above.
# From Firebase Console → Project Settings → Service accounts → Generate new private key.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

