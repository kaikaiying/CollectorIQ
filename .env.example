# Firebase: add a Web app in Firebase Console (Project Settings → Your apps) and paste the config below.
# For production (e.g. Vercel), set these same variables in your host's environment.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional, for Analytics
VITE_FIREBASE_MEASUREMENT_ID=

# Optional: override API base (e.g. https://your-api.vercel.app). Leave blank when API is on same host.
# VITE_API_URL=

# --- Backend (Vercel serverless / API routes) ---
# Stripe: Create Product "Collector IQ" with Price $6.99 CAD/month
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_PRICE_ID=price_1T2MYJDbIddQ8f8DJnT2J8Bl   # $6.99 CAD/month, no trial
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Firebase Admin (for verifying tokens and writing subscription status from webhook).
# From Firebase Console → Project Settings → Service accounts → Generate new private key.
# Set FIREBASE_PRIVATE_KEY to the "private_key" value; in Vercel you can paste with \n for newlines.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# AI Ask: OpenAI API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxx
# Optional: model (default gpt-4o-mini). e.g. gpt-4o for stronger answers.
# OPENAI_MODEL=gpt-4o-mini
